# --- Heavy media: keep out of git (store externally / Git LFS if needed) ---
*.mp4
*.mov
*.MOV
*.avi
*.psd
*.PSD
*.ai
*.png
*.jpg
*.jpeg
*.JPG
*.JPEG
*.PNG
*.gif
*.webp
*.tiff

# Dedicated media folders
Raw Hero video/
VIdeo AI Startruck/

# Keep lightweight vector + source assets (SVG is allowed by default)
!*.svg

# Gli asset web-ready generati da scripts/prepare-media.mjs SONO versionati:
# servono al build di GitHub Pages e sono già compressi (video < 2,5 MB l'uno).
# I sorgenti pesanti (OneDrive) restano fuori.
!public/img/*.webp
!public/logos/*.webp
!public/orbit/**/*.webp
!public/orbit/**/*.mp4
!public/video/*.mp4
!public/og-*.webp
!public/og-*.jpg
!public/lavori/*.webp
!public/clienti/*.webp
!public/optionals/*.webp
!public/tread.png

# --- OS / editor cruft ---
Thumbs.db
desktop.ini
.DS_Store
*~

# --- Local tooling ---
.claude/settings.local.json
node_modules/
dist/
.env
.env.*

# --- Node / Astro build ---
node_modules/
dist/
.astro/
*.log
.DS_Store

# --- Prototipo remake ---
# Gli asset generati (griglia lavori, battistrada, poster delle card) vanno
# versionati: il workflow "Ultimi lavori" li committa, e le regole *.webp /
# *.png qui sopra altrimenti li scartano in silenzio.
!Remake/Archivio/lavori/*.webp
!Remake/Archivio/optionals/*.webp
!Remake/Archivio/clienti/*.webp
!Remake/Archivio/poster-*.webp
!Remake/Archivio/tread.png
!Remake/Archivio/logo.png

# Il template delle variabili resta tracciato, il .env vero no
!.env.example

# Archivio compresso: e la stessa roba della cartella, 16 MB in piu per nulla
*.zip

# Vecchia copia pubblicata del prototipo (scripts/sync-remake.mjs, ora in
# archive/): se ne resta una in locale, non va versionata.
public/remake/
