# --- Heavy media: keep out of git (store externally / Git LFS if needed) ---
*.mp4
*.mov
*.MOV
*.avi
*.psd
*.PSD
*.ai
*.png
*.jpg
*.jpeg
*.JPG
*.JPEG
*.PNG
*.gif
*.webp
*.tiff

# Dedicated media folders
Raw Hero video/
VIdeo AI Startruck/

# Keep lightweight vector + source assets (SVG is allowed by default)
!*.svg

# Gli asset web-ready generati da scripts/prepare-media.mjs SONO versionati:
# servono al build di GitHub Pages e sono già compressi (video < 2,5 MB l'uno).
# I sorgenti pesanti (OneDrive) restano fuori.
!public/img/*.webp
!public/logos/*.webp
!public/orbit/**/*.webp
!public/orbit/**/*.mp4
!public/video/*.mp4
!public/og-*.webp
!public/og-*.jpg

# --- OS / editor cruft ---
Thumbs.db
desktop.ini
.DS_Store
*~

# --- Local tooling ---
.claude/settings.local.json
node_modules/
dist/
.env
.env.*

# --- Node / Astro build ---
node_modules/
dist/
.astro/
*.log
.DS_Store
