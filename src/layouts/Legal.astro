---
import Site from './Site.astro';

interface Props {
  title: string;
  updated: string;
  intro?: string;
}
const { title, updated, intro } = Astro.props;
---
<Site title={`${title} | Startruck Italia`} description={intro}>
  <section class="section lg-head">
    <div class="wrap">
      <span class="sec-eyebrow">Informazioni legali</span>
      <h1>{title}</h1>
      <p class="lg-updated mono">Ultimo aggiornamento: {updated}</p>
    </div>
  </section>

  <section class="section lg-body">
    <div class="wrap">
      <article class="prose"><slot /></article>
    </div>
  </section>
</Site>

<style>
  .lg-head { padding: 90px 0 56px; border-bottom: 1px solid var(--line); }
  .lg-head h1 { font-size: clamp(2.2rem, 5vw, 3.6rem); }
  .lg-updated { margin-top: 18px; font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--charcoal-dim); }
  .lg-body { padding-top: 64px; background: var(--white); }

  .prose { max-width: 72ch; }
  .prose :global(h2) {
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 700;
    font-size: clamp(1.25rem, 2vw, 1.55rem);
    letter-spacing: 0.01em;
    margin: 2.75rem 0 0.9rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--line);
  }
  .prose :global(h2:first-child) { margin-top: 0; padding-top: 0; border-top: 0; }
  .prose :global(p) { color: var(--ink-soft); margin-bottom: 1rem; }
  .prose :global(ul) { color: var(--ink-soft); margin: 0 0 1rem 1.1rem; list-style: disc; }
  .prose :global(li) { margin-bottom: 0.4rem; }
  .prose :global(strong) { font-weight: 600; }
  .prose :global(a) { border-bottom: 1px solid var(--line); }
  .prose :global(a:hover) { border-color: var(--ink); }
  /* I dati che il cliente deve ancora fornire restano visibilmente incompleti */
  .prose :global(mark) {
    background: #fff3cd;
    color: #6b5200;
    padding: 0.1em 0.4em;
    font-size: 0.92em;
  }
</style>
