---
import { base } from '../lib/base';
import { lines } from '../data/lines';

// L'anno lo riscrive nav.js al caricamento; questo e' quello del build.
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap foot-grid">
    <div class="foot-brand">
      <div class="foot-mark">
        <img src={base('onlylogo.svg')} alt="" width="46" height="18" />
        <span>Startruck</span>
      </div>
      <p>Allestimenti su misura per il trasporto di ogni tipo di veicolo. Artigianalità italiana, Pozzolo sul Mincio (MN).</p>
    </div>

    <nav aria-label="Allestimenti">
      <h2 class="foot-label" data-index="[ A ]">Allestimenti</h2>
      <ul class="foot-list">
        {lines.map((l) => <li><a href={base(`/allestimenti/${l.slug}/`)}>{l.name}</a></li>)}
        <li><a href={base('/#processo')}>Processo</a></li>
      </ul>
    </nav>

    <div>
      <h2 class="foot-label" data-index="[ C ]">Contatti</h2>
      <ul class="foot-list">
        <li><a href="tel:+393408427538">+39 340 842 7538</a></li>
        <li><a href="mailto:startruck@outlook.it">startruck@outlook.it</a></li>
        <li>Str. Boschi, 46045<br />Pozzolo sul Mincio (MN)</li>
      </ul>
    </div>
  </div>

  <div class="wrap" aria-hidden="true">
    <div class="foot-wordmark">
      <img src={base('wordmark-startruck.svg')} alt="" width="2653" height="937" loading="lazy" decoding="async" />
    </div>
  </div>

  <div class="foot-legal-bar">
    <div class="wrap foot-legal">
      <span class="mono">© <span id="footYear">{year}</span> Startruck Italia — P.IVA 02628680205</span>
      <div class="foot-policies mono">
        <a href={base('/privacy-policy/')}>Privacy Policy</a>
        <a href={base('/cookie-policy/')}>Cookie Policy</a>
      </div>
    </div>
  </div>
</footer>
