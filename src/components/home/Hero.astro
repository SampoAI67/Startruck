---
import { base } from '../../lib/base';
---
<section class="hero" id="home">
  <video class="hero-video" autoplay muted loop playsinline poster="https://static.wixstatic.com/media/d56fb4_46c84cf020194791afba99d315b8882d~mv2.jpeg/v1/fill/w_1450,h_580,q_90,enc_avif,quality_auto/d56fb4_46c84cf020194791afba99d315b8882d~mv2.jpeg">
    <source src={base('video/startruck-reel.mp4')} type="video/mp4" />
  </video>
  <div class="hero-overlay"></div>
  <div class="wrap hero-inner">
    <span class="eyebrow">Made in Italy — Allestimenti su misura</span>
    <h1>Costruiti per correre.<br />Pensati per <em>durare</em>.</h1>
    <p>Completamente in alluminio: leggeri, robusti e curati in ogni rifinitura.</p>
    <div class="hero-ctas">
      <a href="#configuratore" class="btn-primary">Richiedi un preventivo</a>
      <a href="#modelli" class="btn-ghost">Scopri gli allestimenti</a>
    </div>
  </div>
</section>
