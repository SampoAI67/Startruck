---
// Pagine del vecchio sito che ora sono sezioni della casa: chi arriva da un
// link salvato o da un motore di ricerca non trova un 404.
import { base } from '../lib/base';

interface Props { to: string }
const to = base(Astro.props.to);
---
<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={to} />
    <meta http-equiv="refresh" content={`0; url=${to}`} />
    <title>Startruck Italia</title>
  </head>
  <body>
    <p><a href={to}>Vai alla pagina</a></p>
  </body>
</html>
