---
// Dopo la consegna: le stesse promesse delle domande frequenti delle pagine
// modello (omologazione, assistenza), qui dette come impegno dell'officina.
const items = [
  { t: 'Omologazione inclusa', d: 'Ogni mezzo esce con la pratica di omologazione completa e i documenti pronti per la circolazione.' },
  { t: 'Assistenza diretta', d: "Risponde chi l'ha costruito, non un centralino: conosce il tuo mezzo perché ci ha lavorato." },
  { t: 'Ricambi e regolazioni', d: "Un pezzo da sostituire o una regolazione un anno dopo: si torna da noi, e sappiamo già cosa c'è sotto." },
];
---
<section class="section about-promise" id="dopo-la-consegna">
  <div class="wrap promise-grid">
    <div>
      <span class="sec-eyebrow">Dopo la consegna</span>
      <h2>Il mezzo è tuo.<br />Noi restiamo.</h2>
    </div>
    <ul class="promise-list">
      {items.map((it) => (
        <li>
          <span class="promise-mark" aria-hidden="true">///</span>
          <div><h3>{it.t}</h3><p>{it.d}</p></div>
        </li>
      ))}
    </ul>
  </div>
</section>
