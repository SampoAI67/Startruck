---
import { base } from '../lib/base';

// Le voci puntano alle sezioni della pagina di casa: da un'altra pagina ci si
// torna, dalla casa si scorre e basta.
const links = [
  { href: base('/'), label: 'Home' },
  { href: base('/#modelli'), label: 'Modelli' },
  { href: base('/#lavori'), label: 'Ultimi lavori' },
  { href: base('/#contatti'), label: 'Contatti' },
];
const panelLinks = [
  ...links.slice(0, 3),
  { href: base('/#processo'), label: 'Processo' },
  links[3],
];
---
<header class="site">
  <nav class="wrap" aria-label="Principale">
    <a href={base('/')} class="logo-img"><img src={base('logo-startruck.svg')} alt="Startruck Italia" width="588" height="100" /></a>
    <div class="navlinks">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </div>
    <a href={base('/#configuratore')} class="navcta">Configura preventivo</a>
    <button class="navtoggle" id="navToggle" type="button" aria-label="Menu" aria-expanded="false" aria-controls="navPanel">☰</button>
    <div class="navpanel" id="navPanel">
      {panelLinks.map((l) => <a href={l.href}>{l.label}</a>)}
    </div>
  </nav>
</header>
