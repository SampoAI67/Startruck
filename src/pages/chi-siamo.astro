---
import '../styles/home.css';
import '../styles/about.css';
import '../styles/model.css';
import Site from '../layouts/Site.astro';
import Hero from '../components/home/Hero.astro';
import Ticker from '../components/home/Ticker.astro';
import Clients from '../components/home/Clients.astro';
import Story from '../components/about/Story.astro';
import Place from '../components/about/Place.astro';
import Material from '../components/about/Material.astro';
import Projects from '../components/about/Projects.astro';
import Events from '../components/about/Events.astro';
import Section from '../components/model/Section.astro';
import ContactForm from '../components/model/ContactForm.astro';

// Hero: il reel della demo WordPress del cliente (Startruck-Reel-1-Edit-2.mov,
// verticale 1080x1920). Su schermo largo se ne usa una fascia orizzontale
// al centro, su telefono il fotogramma intero; il logo finale e' tagliato.
---
<Site
  title="Chi siamo — l'officina | Startruck Italia"
  description="Startruck Italia progetta e costruisce a mano allestimenti in alluminio per il trasporto di ogni tipo di veicolo, nella sua officina di Pozzolo sul Mincio (MN)."
>
  <Hero
    id="chi-siamo"
    eyebrow="Chi siamo — Pozzolo sul Mincio (MN)"
    text="Progettiamo e costruiamo a mano allestimenti in alluminio per il trasporto di ogni tipo di veicolo."
    video="video/chi-siamo-hero.mp4"
    videoMobile="video/chi-siamo-hero-mobile.mp4"
    poster="img/chi-siamo-hero.webp"
    wide
    ctas={[
      { href: '#sede', label: 'Vieni a trovarci' },
      { href: '#storia', label: 'La nostra storia' },
    ]}
  >
    <Fragment slot="title">Noi siamo:<br />estremamente leggeri,<br />incredibilmente robusti<br />ed <em>esteticamente superiori</em>.</Fragment>
  </Hero>

  <Ticker />

  <Story />

  <Material />

  <Projects />

  <Events />

  <Clients />

  <Place />

  <!-- lo stesso modulo delle pagine modello, con i loro stili (.mp): la
       richiesta parte come "Richiesta generica" -->
  <div class="mp" id="scrivici">
    <Section tone="dark">
      <ContactForm />
    </Section>
  </div>
</Site>

<script>
  // comparse e invio del modulo: lo stesso script delle pagine modello
  import '../scripts/model-page.js';
</script>
