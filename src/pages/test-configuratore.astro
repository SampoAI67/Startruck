---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import Turntable from '../components/Turntable.astro';
import type { Hotspot } from '../components/Turntable.astro';

// PAGINA DI PROVA — non collegata dal menù, esclusa dai motori di ricerca.
// Serve a decidere se il "clic su accessorio → rotazione + zoom" regge, prima
// di portarlo dentro le pagine degli allestimenti.
//
// Rotazione: un unico MP4 (public/orbit/lemans/orbit.mp4) da 10 s che copre
// 360°, generato da Raw Hero video/orbit-lemans-360-4k.mp4. Gli accessori
// puntano ad ANGOLI, non a numeri di fotogramma: 150° (3/4 posteriore),
// 201° (posteriore), 291° (fiancata).
// La modalità calibrazione è attiva: cliccando si leggono angolo e coordinate.
const items: Hotspot[] = [
  {
    id: 'pianale',
    title: 'Pianale',
    spec: 'Pianale 5.000 × 2.130 mm',
    desc: 'Alluminio estruso, superficie antiscivolo e punti di ancoraggio distribuiti su tutta la lunghezza.',
    angle: 150, focus: { x: 0.34, y: 0.60 }, zoom: 2.0,
  },
  {
    id: 'rampe',
    title: 'Rampe a scomparsa',
    desc: 'Si sfilano da sotto il pianale e rientrano a filo: nessun ingombro esterno, nessun pezzo da caricare a parte.',
    angle: 201, focus: { x: 0.565, y: 0.638 }, zoom: 3.0,
  },
  {
    id: 'verricello',
    title: 'Verricello traslabile',
    desc: 'Scorre lateralmente per allinearsi all’auto invece di costringere l’auto ad allinearsi a lui. Tiro sempre dritto.',
    angle: 291, focus: { x: 0.385, y: 0.51 }, zoom: 3.2,
  },
  {
    id: 'fune',
    title: 'Fune sintetica',
    desc: 'Più leggera dell’acciaio e più sicura in caso di rottura: non frusta. Si maneggia a mani nude.',
    angle: 201, focus: { x: 0.465, y: 0.50 }, zoom: 4.0,
  },
  {
    id: 'fari',
    title: 'Fari LED notturni',
    desc: 'Illuminano l’area di lavoro dietro al mezzo. Carico e scarico al buio senza torce né improvvisazione.',
    angle: 201, focus: { x: 0.524, y: 0.466 }, zoom: 3.2,
    note: 'Nel girato sono spenti: si vedono i due corpi incassati nella paratia. Da confermare col cliente che sia questo il pezzo.',
  },
  {
    id: 'ingombro',
    title: 'Luci ingombro laterali LED',
    desc: 'Profilo del mezzo sempre leggibile agli altri, anche con poca luce e in manovra.',
    angle: 150, focus: { x: 0.352, y: 0.688 }, zoom: 4.0,
  },
  {
    id: 'cinghie',
    title: 'Set 4 cinghie',
    desc: 'Quattro cinghie a cricchetto con ganci dedicati agli ancoraggi del pianale. Incluse, non un accessorio.',
    angle: 201, focus: { x: 0.58, y: 0.527 }, zoom: 4.0,
    note: 'Sul pianale se ne vede una sola, appoggiata accanto al verricello.',
  },
];
---
<Base title="Prova — configuratore accessori | Startruck" description="Pagina di prova interna." noindex>
  <Section tone="dark" pad="loose" class="pt-40 md:pt-48">
    <p class="label mb-7" data-index="[ TEST ]" data-reveal>Prototipo · non in produzione</p>
    <h1 class="tc-title" data-reveal>
      <span class="mask-line"><span>Configuratore</span></span>
      <span class="mask-line"><span style="--d:.09s" class="text-white/45">accessori.</span></span>
    </h1>
    <p class="mt-7 max-w-2xl text-soft" data-reveal data-delay=".2s">
      Scegli un accessorio dall'elenco: il mezzo ruota fino all'angolo che lo mostra meglio
      e poi zooma sul punto. Puoi anche trascinare per girare a mano.
    </p>
  </Section>

  <Section tone="dark" pad="none" class="pb-24 md:pb-32">
    <Turntable
      dir="orbit/lemans"
      duration={10}
      items={items}
      hiAngles={[150, 201, 291]}
      calibrate
    />
  </Section>

  <!-- Note tecniche: restano su questa pagina, non nel sito vero -->
  <Section tone="light" label="Note tecniche" index="[ i ]">
    <div class="grid gap-x-14 gap-y-10 lg:grid-cols-2">
      <div>
        <h2 class="display-3 mb-4 font-bold">Cosa stiamo guardando</h2>
        <p class="text-soft mb-4">
          Non è più una sequenza di immagini ma <strong>un solo video</strong> da
          <strong>1,85 MB</strong>: lo decodifica il browser, quindi si ottengono
          <strong>240 posizioni (1,5°)</strong> con metà del peso delle 120 immagini
          di prima. Sempre senza WebGL né modelli 3D.
        </p>
        <p class="text-soft mb-4">
          La rotazione d'attesa è semplice riproduzione: nessuna animazione scritta a
          mano può essere più fluida. Trascinando si sposta il tempo del video, e i
          salti vengono accodati uno per volta — assegnarli a raffica intaserebbe il
          decoder, soprattutto su iPhone.
        </p>
        <p class="text-soft">
          Restano i <strong>fermo-immagine a 3200 px</strong> (0,3 MB, scaricati solo
          al momento dello zoom): a 4× il video a 1280 px non reggerebbe, così il
          primo piano resta nitido.
        </p>
      </div>

      <div>
        <h2 class="display-3 mb-4 font-bold">Cosa resta da sistemare</h2>
        <ul class="tc-list text-soft">
          <li><strong>Da provare su un iPhone vero.</strong> La ricerca dentro un video è la parte meno prevedibile: su iOS può risultare meno reattiva che su desktop. È il rischio noto di questa soluzione.</li>
          <li>Il mezzo <strong>respira leggermente</strong> nell'inquadratura (la distanza dalla camera non è costante). Su una piattaforma rotante sparirebbe del tutto.</li>
          <li>Il 4K è <strong>ricostruito da un upscaler</strong>, non ripreso: il dettaglio a forte ingrandimento è plausibile, non necessariamente fedele.</li>
          <li>I <strong>fari LED</strong> nel girato sono spenti: va confermato col cliente che il pezzo inquadrato sia quello giusto.</li>
          <li>Sul pianale c'è <strong>una sola cinghia</strong> appoggiata, non il set completo.</li>
        </ul>
      </div>
    </div>
  </Section>
</Base>

<style>
  .tc-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2.4rem, 7vw, 5rem);
    line-height: 0.96;
    letter-spacing: -0.035em;
  }
  .tc-list { display: grid; gap: 0.85rem; list-style: disc; margin-left: 1.1rem; }
  .tc-list li { padding-left: 0.2rem; }
  code {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.88em;
    background: var(--color-surface);
    padding: 0.1em 0.4em;
    border-radius: 3px;
  }
</style>
