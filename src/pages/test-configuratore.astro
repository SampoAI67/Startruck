---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import Turntable from '../components/Turntable.astro';
import type { Hotspot } from '../components/Turntable.astro';

// PAGINA DI PROVA — non collegata dal menù, esclusa dai motori di ricerca.
// Serve a decidere se il "clic su accessorio → rotazione + zoom" regge, prima
// di portarlo dentro le pagine degli allestimenti.
//
// I fotogrammi vengono dal girato reale (Raw Hero video/IMG_3411_3.mp4): un
// arco di ~180°, non una piattaforma rotante. Le coordinate qui sotto sono
// una prima taratura a occhio: la pagina ha la modalità calibrazione attiva,
// basta cliccare sul mezzo per leggere le coordinate esatte di un punto.
const NOT_FITTED = 'Non montato su questo esemplare: il punto è indicativo. Con un mezzo allestito completamente lo zoom inquadrerebbe il pezzo reale.';

const items: Hotspot[] = [
  {
    id: 'pianale',
    title: 'Pianale',
    spec: 'Pianale 5.000 × 2.130 mm',
    desc: 'Alluminio estruso, superficie antiscivolo e punti di ancoraggio distribuiti su tutta la lunghezza.',
    frame: 24, focus: { x: 0.72, y: 0.62 }, zoom: 1.9,
  },
  {
    id: 'fari',
    title: 'Fari LED notturni',
    desc: 'Illuminano l’area di lavoro dietro al mezzo. Carico e scarico al buio senza torce né improvvisazione.',
    frame: 33, focus: { x: 0.39, y: 0.36 }, zoom: 2.3,
  },
  {
    id: 'ingombro',
    title: 'Luci ingombro laterali LED',
    desc: 'Profilo del mezzo sempre leggibile agli altri, anche con poca luce e in manovra.',
    frame: 24, focus: { x: 0.667, y: 0.752 }, zoom: 3.2,
  },
  {
    id: 'rampe',
    title: 'Rampe a scomparsa',
    desc: 'Si sfilano da sotto il pianale e rientrano a filo: nessun ingombro esterno, nessun pezzo da caricare a parte.',
    frame: 33, focus: { x: 0.62, y: 0.71 }, zoom: 2.4,
    note: 'Rientrate e in ombra in questo girato al tramonto: si intuisce il vano, non il pezzo.',
  },
  {
    id: 'verricello',
    title: 'Verricello traslabile',
    desc: 'Scorre lateralmente per allinearsi all’auto invece di costringere l’auto ad allinearsi a lui. Tiro sempre dritto.',
    frame: 24, focus: { x: 0.50, y: 0.52 }, zoom: 2.6,
    note: NOT_FITTED,
  },
  {
    id: 'fune',
    title: 'Fune sintetica',
    desc: 'Più leggera dell’acciaio e più sicura in caso di rottura: non frusta. Si maneggia a mani nude.',
    frame: 24, focus: { x: 0.50, y: 0.52 }, zoom: 2.6,
    note: NOT_FITTED,
  },
  {
    id: 'cinghie',
    title: 'Set 4 cinghie',
    desc: 'Quattro cinghie a cricchetto con ganci dedicati agli ancoraggi del pianale. Incluse, non un accessorio.',
    frame: 28, focus: { x: 0.68, y: 0.55 }, zoom: 2.0,
    note: NOT_FITTED,
  },
];
---
<Base title="Prova — configuratore accessori | Startruck" description="Pagina di prova interna." noindex>
  <Section tone="dark" pad="loose" class="pt-40 md:pt-48">
    <p class="label mb-7" data-index="[ TEST ]" data-reveal>Prototipo · non in produzione</p>
    <h1 class="tc-title" data-reveal>
      <span class="mask-line"><span>Configuratore</span></span>
      <span class="mask-line"><span style="--d:.09s" class="text-white/45">accessori.</span></span>
    </h1>
    <p class="mt-7 max-w-2xl text-soft" data-reveal data-delay=".2s">
      Scegli un accessorio dall'elenco: il mezzo ruota fino all'angolo che lo mostra meglio
      e poi zooma sul punto. Puoi anche trascinare per girare a mano.
    </p>
  </Section>

  <Section tone="dark" pad="none" class="pb-24 md:pb-32">
    <Turntable dir="turntable/lemans" frames={36} items={items} calibrate />
  </Section>

  <!-- Note tecniche: restano su questa pagina, non nel sito vero -->
  <Section tone="light" label="Note tecniche" index="[ i ]">
    <div class="grid gap-x-14 gap-y-10 lg:grid-cols-2">
      <div>
        <h2 class="display-3 mb-4 font-bold">Cosa stiamo guardando</h2>
        <p class="text-soft mb-4">
          36 fotogrammi estratti dal girato esistente (<code>IMG_3411_3.mp4</code>), non da
          uno shooting dedicato. Pesano <strong>370 KB in tutto</strong> — meno di una
          singola foto della gallery — e girano su qualsiasi telefono senza WebGL.
        </p>
        <p class="text-soft">
          La rotazione copre circa <strong>180°</strong>, da muso a coda: è quanto la camera
          percorre in quel girato. Per il giro completo serve una ripresa fatta apposta.
        </p>
      </div>

      <div>
        <h2 class="display-3 mb-4 font-bold">Limiti di questa prova</h2>
        <ul class="tc-list text-soft">
          <li>Il mezzo <strong>si sposta nell'inquadratura</strong>: la camera girava a mano, non su piattaforma. In uno shooting dedicato resta centrato.</li>
          <li>Il girato è al <strong>tramonto</strong>: schiarito via CSS sullo zoom, ma alcuni accessori restano poco leggibili.</li>
          <li>Le posizioni degli accessori sono <strong>tarate a occhio</strong>. La modalità calibrazione è attiva: clicca sul mezzo per leggere le coordinate esatte.</li>
          <li>Verricello, fune e cinghie <strong>non sono montati</strong> su questo esemplare: i punti sono indicativi.</li>
        </ul>
      </div>
    </div>
  </Section>
</Base>

<style>
  .tc-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2.4rem, 7vw, 5rem);
    line-height: 0.96;
    letter-spacing: -0.035em;
  }
  .tc-list { display: grid; gap: 0.85rem; list-style: disc; margin-left: 1.1rem; }
  .tc-list li { padding-left: 0.2rem; }
  code {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.88em;
    background: var(--color-surface);
    padding: 0.1em 0.4em;
    border-radius: 3px;
  }
</style>
